# Optional: copy to .env.backend at the project root. Never commit the copy.
SPRING_PROFILES_ACTIVE=dev
APP_APPROVED_EMAIL_DOMAINS=srmap.edu.in
APP_ADMIN_EMAIL=shanmukha_thiyyagura@srmap.edu.in
APP_FRONTEND_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173
AUTH_VERIFICATION_MODE=otp
COOKIE_SECURE=false
# Local defaults use persistent H2: no database installation required.
# Production uses DATABASE_URL supplied by Neon; DB_SCHEMA isolates secure tables.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DB_SCHEMA=javac_secure
# Neon Auth URL includes the /auth suffix. Enable Auth and verification codes in Neon.
# NEON_AUTH_URL=https://your-auth-host.neonauth.region.aws.neon.tech/database/auth
# Without Neon Auth, dev writes codes to backend/dev-mailbox/; prod requires real SMTP.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=shanmukha_thiyyagura@srmap.edu.in
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false
