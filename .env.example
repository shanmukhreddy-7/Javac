# Copy to .env at the javac-campus root. Spring imports this file automatically.
# Verify the institution's actual email domain with your administrator.
APP_APPROVED_EMAIL_DOMAINS=example.edu
DB_URL=jdbc:mysql://localhost:3306/javac?serverTimezone=UTC
DB_USER=javac
DB_PASSWORD=replace-with-your-local-database-password
SPRING_PROFILES_ACTIVE=dev
APP_FRONTEND_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT=30
# dev writes ignored backend/dev-mailbox/*.html; production uses SMTP instead.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@example.edu
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false

# Only required for optional docker compose database setup
DB_ROOT_PASSWORD=replace-with-a-different-local-root-password
